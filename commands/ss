const axios = require('axios');

module.exports = {
    name: 'ss',
    alias: ['screenshot'],
    desc: 'Website screenshot',
    react: '📸',
    category: 'tools',
    async execute(m, { VoidMD, text }) {
        if (!text) return m.reply('URL?\n\n.ss https://google.com');
        if (!text.startsWith('http')) return m.reply('Add https:// 💀');
        await m.react('⏳');
        try {
            await VoidMD.sendMessage(m.chat, {
                image: { url: `https://api.akuari.my.id/tools/ssweb?link=${encodeURIComponent(text)}` },
                caption: `📸 *Screenshot*\n${text}`
            }, { quoted: m });
            await m.react('✅');
        } catch (e) {
            await m.reply('Screenshot failed 💀');
        }
    }
}
